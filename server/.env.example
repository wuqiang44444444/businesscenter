# 复制为 .env 后填实际值。.env 已被 .gitignore，不会被提交。

# JWT 签名密钥，至少 32 字符。生成方法：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 或：openssl rand -hex 32
JWT_SECRET=换成你自己的至少32字符的随机字符串

# 服务监听端口（可选，默认 3001）
PORT=3001

# 部署环境（仅作日志用，不影响 cookie 行为）
# NODE_ENV=production

# 是否要求 cookie 仅在 HTTPS 上发送。默认 false。
# 配好 HTTPS / 反代之后再改 true。HTTP 部署期间务必保持 false 或不设。
# COOKIE_SECURE=true

# ============ 邮件提醒（可选） ============
# SMTP 配好后会自动启动提醒调度器：每小时扫描应收逾期/到期/合同到期 → 发邮件
# 不配则功能停用，不影响其它接口
# 腾讯企业邮箱示例（用授权码而不是密码）：
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=your@yourcompany.com
# SMTP_PASS=授权码
# SMTP_FROM=your@yourcompany.com
# ADMIN_EMAIL=admin@yourcompany.com   ← 用户没填邮箱时的兜底收件人
