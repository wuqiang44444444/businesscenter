# 复制为 .env 后填实际值。.env 已被 .gitignore，不会被提交。

# JWT 签名密钥，至少 32 字符。生成方法：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 或：openssl rand -hex 32
JWT_SECRET=换成你自己的至少32字符的随机字符串

# 服务监听端口（可选，默认 3001）
PORT=3001

# 部署环境（仅作日志用，不影响 cookie 行为）
# NODE_ENV=production

# 是否要求 cookie 仅在 HTTPS 上发送。默认 false。
# 配好 HTTPS / 反代之后再改 true。HTTP 部署期间务必保持 false 或不设。
# COOKIE_SECURE=true
